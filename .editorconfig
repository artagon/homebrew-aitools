root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Do NOT set binary_next_line = true on *.sh: `scripts/**/*.sh` follow Homebrew
# `brew style` (`Homebrew/utils/shfmt.sh` separate-line `then`/`do` without `-bn`).
[*.{sh,bash,bats}]
switch_case_indent = true
